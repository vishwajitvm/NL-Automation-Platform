# Free-tier Primary & Fallback LLM Providers
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=

# Observability (Agent Tracing)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=nl-automation-platform

# Reserve Providers (Not wired into default path)
HUGGINGFACE_API_KEY=
NVIDIA_API_KEY=
KIMI_API_KEY=

# Internal Data & Queue Infrastructure
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/nl_automation
REDIS_URL=redis://redis:6379/0

# Port Overrides (Optional)
API_GATEWAY_PORT=8080
FRONTEND_PORT=3001

# --- Email sending (Phase 10) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=                # your full email address
SMTP_PASSWORD=                # Gmail: use an App Password, not your real password
SMTP_FROM_NAME=NL-Automation Platform
SMTP_FROM_EMAIL=              # usually same as SMTP_USERNAME
DEFAULT_NOTIFY_EMAIL=         # used when "email me" doesn't specify an address

# --- Dynamic Ethics/Legitimacy Agent (Phase 10) ---
ETHICS_AGENT_PROVIDER=groq              # which existing free provider powers the reasoning judge — no new key needed
ETHICS_AGENT_MODEL=llama-3.3-70b-versatile
PERSON_LOOKUP_REQUIRES_JUSTIFICATION=true   # ambiguous person-search queries ask "what's this for?" before searching

# --- System monitoring rate limits (Phase 10) ---
SYSTEM_MONITOR_POLL_RATE_LIMIT_PER_MIN=30
WEB_SEARCH_RATE_LIMIT_PER_HOUR=20

--- Calendar & Sheets (Phase 12) ---
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=
GOOGLE_CALENDAR_ID=primary
GOOGLE_SHEETS_DEFAULT_SPREADSHEET_ID=

--- SMS (Phase 12) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
